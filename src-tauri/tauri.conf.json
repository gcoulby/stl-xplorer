{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "STL Xplorer",
  "version": "0.2.2",
  "identifier": "dev.stlxplorer.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "STL Xplorer",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0b0c0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost mesh: http://mesh.localhost blob: data:; worker-src 'self' blob:; frame-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../licences/7-Zip-License.txt": "licences/7-Zip-License.txt"
    },
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg1ODdFQTFFNzZFODUxN0QKUldSOVVlaDJIdXFIaGZLbDFHNkdCcTRLelNOdmR1RDN6UXhhditwOXMxYnVMc1JOSnJvRk83WkUK",
      "endpoints": ["https://github.com/gcoulby/stl-xplorer/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
