{
  "name": "stl-xplorer",
  "private": true,
  "version": "0.2.2",
  "license": "MIT",
  "author": "Graham Coulby",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "format": "prettier --write .",
    "setup:7zip": "node scripts/setup-7zip.mjs",
    "build:bundled": "tauri build --config src-tauri/tauri.7zip.conf.json",
    "build:bundled:windows": "tauri build --config src-tauri/tauri.7zip.conf.json --config src-tauri/tauri.7zip.windows.conf.json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
